  "cards": [
    {
      "dot": "cyan",
      "title": "Two separate command scenarios",
      "items": [
        "Snapshot twice around controlled human reconnects.",
        "Diff reads both files; stdout becomes a file only if redirected."
      ]
    },
    {
      "dot": "amber",
      "title": "Privacy is a transformation",
      "items": [
        "Supported private fields redacted; unknown identifiers may remain.",
        "No automatic raw store or upload. Inspect before sharing."
      ]
    },
    {
      "dot": "slate",
      "title": "Failure and scope",
      "items": [
        "Invalid / oversized input or malformed private fields fail.",
